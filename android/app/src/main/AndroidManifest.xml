<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Menu « Partager » d'Android, texte uniquement : permet d'envoyer à Trusti le
              lien d'une app depuis le Play Store ou F-Droid (voir ShareTargetPlugin).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Requise depuis Android 11 (API 30) pour lancer la boîte de dialogue système
      de désinstallation d'un paquet qui n'appartient pas à Trusti (ACTION_DELETE /
      ACTION_UNINSTALL_PACKAGE ciblant un autre package). Permission "normale",
      accordée automatiquement à l'installation, aucune demande à l'utilisateur.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Permission spéciale (non accordable via une boîte de dialogue runtime standard)
      permettant de lire l'espace disque (APK + données + cache) des autres apps du
      catalogue Trusti, pour l'écran "Espace de stockage". L'utilisateur doit
      l'activer manuellement dans Réglages > Apps > Accès spécial > Accès à
      l'utilisation (voir InstalledAppsPlugin.hasUsageAccess/openUsageAccessSettings).
      Sans cet accès, l'app continue de fonctionner normalement : cette donnée est
      simplement masquée derrière une invitation à l'activer.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Accès spécial "Accès à tous les fichiers" (API 30+), requis uniquement par le nettoyeur de
      stockage (SystemCleanerPlugin) pour parcourir le stockage partagé. Activé manuellement par
      l'utilisateur dans les réglages Android ; jamais demandé tant qu'il n'ouvre pas le nettoyeur.
      Retirée du build Play Store (src/release/AndroidManifest.xml), où Google la restreint :
      le nettoyeur n'y est alors pas proposé. Présente dans les APK des releases GitHub.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Scan complet des apps installées (voir InstalledAppsPlugin.hasFullScan/getAllInstalledApps) :
      permet de repérer toutes les apps du téléphone, pas seulement celles de la liste <queries>
      ci-dessous. Google Play restreint cette permission (liste d'apps installées jugée sensible) :
      elle est donc retirée du build Play Store (src/release/AndroidManifest.xml), qui garde le
      scan par liste. Présente dans les APK des releases GitHub. La liste reste lue en local,
      jamais envoyée au serveur.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Visibilité des paquets pour le scan d'apps installées (onboarding natif Android).
      On liste explicitement chaque app connue du catalogue Trusti plutôt que de demander
      la permission QUERY_ALL_PACKAGES (très restreinte par Google Play depuis 2021 et
      rarement accordée pour ce cas d'usage). Ce bloc est généré automatiquement par
      `npm run android:generate-catalog` — ne pas éditer à la main, relancer le script
      après toute mise à jour du catalogue.
    -->
