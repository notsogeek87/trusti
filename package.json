{
  "name": "trusti",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "android:generate-catalog": "node scripts/generate-android-catalog.js",
    "android:bundle-icons": "node scripts/bundle-app-icons.js",
    "cap:sync": "npm run android:generate-catalog && npm run android:bundle-icons && vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "db:migrate-to-postgres": "node server/database/migrate-to-postgres.js",
    "db:add-otp-attempts": "node server/database/add-otp-attempts-table.js",
    "db:add-popularity": "node server/database/add-popularity-column.js",
    "db:add-team-pick": "node server/database/add-team-pick-columns.js",
    "icons:fetch": "node server/database/fetch-icons-playstore.js",
    "test": "node --test 'tests/technical/**/*.test.js' 'tests/cleaner/**/*.test.js' 'tests/server/**/*.test.js'",
    "build": "vite build",
    "vibe:analyze": "node scripts/vibe-analyze.js",
    "vibe:check": "node scripts/vibe-check.js",
    "preview": "vite preview",
    "vercel-build": "vite build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "google-play-scraper": "^10.1.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.4"
  }
}
