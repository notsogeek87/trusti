{
  "name": "trustiscore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "android:generate-catalog": "node scripts/generate-android-catalog.js",
    "cap:sync": "npm run android:generate-catalog && vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "db:migrate-to-postgres": "node server/database/migrate-to-postgres.js",
    "db:add-otp-attempts": "node server/database/add-otp-attempts-table.js",
    "db:add-popularity": "node server/database/add-popularity-column.js",
    "icons:fetch": "node server/database/fetch-icons-playstore.js",
    "check:resend": "node check-resend-config.js",
    "check:brevo": "node check-brevo-config.js",
    "test:email": "node check-brevo-config.js",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-build": "vite build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@getbrevo/brevo": "^3.0.1",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "google-play-scraper": "^10.1.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.9.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.2"
  }
}
