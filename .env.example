# Configuration de la base de données PostgreSQL (Neon)
# 
# Pour obtenir votre DATABASE_URL:
# 1. Créer un compte sur https://neon.tech (gratuit)
# 2. Créer un nouveau projet
# 3. Copier la connection string depuis le dashboard
# 4. Renommer ce fichier en .env et remplacer la valeur ci-dessous

DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
