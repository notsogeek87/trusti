# Configuration de la base de données PostgreSQL (Neon)
# 
# Pour obtenir votre DATABASE_URL:
# 1. Créer un compte sur https://neon.tech (gratuit)
# 2. Créer un nouveau projet
# 3. Copier la connection string depuis le dashboard
# 4. Renommer ce fichier en .env et remplacer la valeur ci-dessous

DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# ===== BREVO (Sendinblue) - Service d'envoi d'emails =====
# Pour obtenir votre clé API Brevo :
# 1. Créer un compte sur https://app.brevo.com/account/register (gratuit jusqu'à 9000 emails/mois)
# 2. Aller dans SMTP & API → API Keys
# 3. Créer une nouvelle clé (v3)
# 4. Copier la clé ici
# ⭐ Avantage : Pas de sandbox, envoi immédiat à tous les emails !

BREVO_API_KEY=votre-cle-api-brevo-ici
BREVO_FROM_EMAIL=noreply@votredomaine.com
BREVO_FROM_NAME=TrustiScore

# ===== ANCIENNE CONFIG RESEND (optionnelle) =====
# Si vous préférez utiliser Resend au lieu de Brevo :
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=TrustiScore <noreply@votredomaine.com>

# URL du frontend (pour les liens de connexion)
FRONTEND_URL=https://trusti.vercel.app

# Environment
NODE_ENV=development

# ===== ADMIN ACCESS =====
# Email autorisé à déverrouiller l'administration (reçoit un code OTP)
# Si absent, tout email connecté peut demander un accès admin (dev uniquement)
ADMIN_EMAIL=votre@email.com
