# Base de données PostgreSQL (en production : PostgreSQL d'Hyperfluid)
#
# N'importe quel PostgreSQL convient (local, Docker, hébergé).
# Renommer ce fichier en .env et remplacer la valeur ci-dessous.

DATABASE_URL=postgresql://user:password@localhost:5432/trusti

# URL du frontend
FRONTEND_URL=https://app.trusti-score.eu

# Environment
NODE_ENV=development

# ===== INTEGRATIONS EXTERNES (n8n, etc.) =====
# Clé requise dans l'en-tête x-api-key pour créer/modifier/supprimer des
# apps via l'API (n8n, scripts). Sans elle, toute écriture est refusée.
# Générer une valeur aléatoire, ex: openssl rand -hex 32
API_KEY=changez-moi-aussi
