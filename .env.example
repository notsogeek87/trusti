# Configuration de la base de données PostgreSQL (Neon)
# 
# Pour obtenir votre DATABASE_URL:
# 1. Créer un compte sur https://neon.tech (gratuit)
# 2. Créer un nouveau projet
# 3. Copier la connection string depuis le dashboard
# 4. Renommer ce fichier en .env et remplacer la valeur ci-dessous

DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Configuration de l'envoi d'emails (Resend)
#
# Pour obtenir votre RESEND_API_KEY:
# 1. Créer un compte sur https://resend.com (gratuit jusqu'à 3000 emails/mois)
# 2. Aller dans API Keys
# 3. Créer une nouvelle clé
# 4. Vérifier votre domaine d'envoi (ou utiliser onboarding@resend.dev pour les tests)

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=TrustiScore <noreply@votredomaine.com>

# URL du frontend (pour les liens de connexion)
FRONTEND_URL=https://trusti.vercel.app

# Environment
NODE_ENV=development
